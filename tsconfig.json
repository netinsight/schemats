{
    "compilerOptions": {
        "module": "NodeNext",
        "target": "ESNext",
        "esModuleInterop": true,
        "rootDir": "./",
        "outDir": "./dist",
        "declaration": true,
        "strict": true,
        "sourceMap": true,
        "resolveJsonModule": true,
        "types": ["node"]
    },
    "include": ["./src/**/*.ts", "./bin/**/*.ts"],
    "exclude": ["node_modules"]
}
